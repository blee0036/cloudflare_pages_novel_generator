{
  "name": "cloudflare-pages-novel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run",
    "preprocess": "python scripts/preprocess.py",
    "preprocess-clean": "python scripts/preprocess.py --delete-source",
    "e2e": "node e2e/run.mjs --profile all",
    "e2e:profile": "node e2e/run.mjs",
    "e2e:update": "node e2e/run.mjs --profile fixture --update",
    "e2e:fixture": "python e2e/fixture/generate.py",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "3.23.2",
    "globals": "17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.70.1",
    "vite": "^5.4.10",
    "vitest": "2.1.9"
  }
}
